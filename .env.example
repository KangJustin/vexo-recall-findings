# Copy to .env (git-ignored) and fill in. Never commit .env or paste keys into chats.
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
# Hugging Face read token with access to the gated pyannote/segmentation-3.0 (accept its conditions first)
HF_TOKEN=

# Speaker service (optional overrides; defaults shown in speaker_service/config.py)
SPEAKER_SEGMENTATION_MODEL=
SPEAKER_EMBEDDING_MODEL=
SPEAKER_STEP=
SPEAKER_LATENCY=
SPEAKER_WEARER_YES=
SPEAKER_WEARER_NO=
SPEAKER_WEARER_MIN_SECONDS=
SPEAKER_MAX_LAG=
SPEAKER_PROFILE=
SPEAKER_DEVICE=
